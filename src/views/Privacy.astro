---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const pv = d.privacy;
const hl = lang === 'zh-hans' ? 'zh-CN' : lang === 'zh-hant' ? 'zh-TW' : lang;
---
<Base lang={lang} page="privacy" title={d.seo.privacy.title} description={d.seo.privacy.description}>
  <header class="page-head"><div class="wrap"><h1>{pv.title}</h1><p class="lead">{pv.updated}</p></div></header>
  <section class="section">
    <div class="wrap narrow">
      {pv.sections.map((sec, i) => (
        <section class="privacy-sec">
          <h2>{sec.title}</h2>
          <p>{sec.body}</p>
          {i === 1 && (
            <p class="privacy-links">
              <a href={`https://policies.google.com/technologies/partner-sites?hl=${hl}`} target="_blank" rel="noopener">{pv.googlePolicy}</a>　
              <a href={`https://tools.google.com/dlpage/gaoptout?hl=${hl}`} target="_blank" rel="noopener">{pv.optout}</a>
            </p>
          )}
          {i === 3 && <p><a href={`tel:${site.phoneIntl}`}>{lang === 'ja' ? site.phone : site.phoneIntlDisplay}</a></p>}
        </section>
      ))}
    </div>
  </section>
</Base>
<style>
  .privacy-sec + .privacy-sec { margin-top: var(--space-l); }
  .privacy-sec h2 { font-size: var(--step-2); margin-bottom: 0.75rem; }
  .privacy-sec p { color: var(--ink-soft); }
  .privacy-sec p + p { margin-top: 0.6rem; }
  .privacy-links a { color: var(--mustard); }
</style>
