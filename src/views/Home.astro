---
import Base from '../layouts/Base.astro';
import InfoList from '../components/InfoList.astro';
import MapBlock from '../components/MapBlock.astro';
import OwnerBlock from '../components/OwnerBlock.astro';
import SoupBlock from '../components/SoupBlock.astro';
import site from '../data/site.json';
import menu from '../data/menu.json';
import { t, pick, pagePath, withBase, yen, type Lang } from '../lib/i18n';
import { restaurantJsonLd } from '../lib/jsonld';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const h = d.home;
const isJa = lang === 'ja';
const items = menu.categories.flatMap((c) => c.items) as any[];
const get = (id: string) => items.find((i) => i.id === id);
const shio = get('shio');
const subs = [get('shoyu'), get('shio-tokusei'), get('seabura')];
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.name + ' ' + site.address.ja)}`;
---
<Base lang={lang} page="home" title={d.seo.home.title} description={d.seo.home.description} jsonLd={restaurantJsonLd(lang, Astro.site!)}>
  <section class={`hero ${isJa ? 'is-vertical' : ''}`}>
    <picture>
      <source media="(max-width: 700px)" srcset={withBase('images/hero-sm.jpg')} width="880" height="986" />
      <img src={withBase('images/hero.jpg')} alt={d.concept.photoAlts.noodles} width="1600" height="1144" fetchpriority="high" />
    </picture>
    <div class="hero-copy">
      <h1>
        <span class="hero-line">{h.heroCopy}</span>
        <span class="visually-hidden">{site.name}</span>
      </h1>
      <p class="hero-sub">{h.heroSub.split('　').map((x) => <span>{x}</span>)}</p>
    </div>
    <img class="hero-badge" src={withBase('images/hyakumeiten-2025.png')} alt={d.ui.badgeAlt} width="240" height="240" />
  </section>

  <div class="notice-bar">
    <div class="wrap notice-inner">
      <p><strong>{d.ui.hours}</strong> {site.hours.map((x) => `${pick(x.days, lang)} ${x.time}`).join('　')}</p>
      <p><strong>{d.ui.closed}</strong> {pick(site.closedShort, lang)}　<a href={site.instagram} target="_blank" rel="noopener">{d.ui.holidayInfo}</a></p>
    </div>
  </div>

  <section class="signature">
    <div class="signature-main">
      <img class="signature-photo" src={withBase('images/' + shio.img)} alt={pick(shio.name, lang)} width="1280" height="960" loading="lazy" decoding="async" />
      <div class="signature-text">
        <h2 class="section-title">{h.signatureTitle}</h2>
        <p class="signature-lead">{h.signatureLead}</p>
        <p class="stamp">{d.ui.recommended}</p>
        <h3>{pick(shio.name, lang)}</h3>
        <p class="signature-desc">{pick(shio.desc, lang)}</p>
        <p class="price">{yen(shio.price)}</p>
      </div>
    </div>
    <div class="wrap signature-subs">
      {subs.map((it) => (
        <article class={`dish ${it.cutout ? 'is-cutout' : ''}`}>
          <img src={withBase('images/' + it.img)} alt={pick(it.name, lang)} width="1200" height="960" loading="lazy" decoding="async" />
          <h3>{pick(it.name, lang)}</h3>
          <p class="price">{yen(it.price)}</p>
        </article>
      ))}
    </div>
    <p class="center signature-cta"><a class="btn btn-light" href={pagePath(lang, 'menu')}>{d.ui.viewMenu}</a></p>
  </section>

  <SoupBlock lang={lang} />

  <section class="section vibe">
    <div class="wrap vibe-grid">
      <img class="vibe-main" src={withBase('images/exterior.jpg')} alt={d.access.photoAlts.exterior} width="1280" height="960" loading="lazy" decoding="async" />
      <div class="vibe-text">
        <h2 class="section-title">{h.vibeTitle}</h2>
        <p>{h.vibeBody}</p>
      </div>
      <img class="vibe-sub" src={withBase('images/counter.jpg')} alt={d.access.photoAlts.counter} width="1000" height="1250" loading="lazy" decoding="async" />
      <img class="vibe-sub" src={withBase('images/tables.jpg')} alt={d.access.photoAlts.tables} width="1000" height="1250" loading="lazy" decoding="async" />
      <img class="vibe-sub" src={withBase("images/entrance.jpg")} alt={d.access.photoAlts.entrance} width="1000" height="1250" decoding="async" />
    </div>
  </section>

  <section class={`manifesto ${isJa ? 'is-vertical' : ''}`}>
    <img src={withBase('images/noodles-close.jpg')} alt="" width="1200" height="900" loading="lazy" decoding="async" />
    <p class="manifesto-text">{h.manifesto.map((l) => <span>{l}</span>)}</p>
  </section>

  <section class="section philosophy">
    <div class="wrap philosophy-grid">
      <div class={`philosophy-lines ${isJa ? 'is-vertical' : ''}`}>
        {h.philosophyLines.map((l) => <p>{l}</p>)}
      </div>
      <div class="philosophy-body">
        <img src={withBase('images/seimen-room.jpg')} alt={d.concept.photoAlts.seimen} width="1000" height="1250" loading="lazy" decoding="async" />
        <p>{h.philosophyBody}</p>
        <a class="text-link" href={pagePath(lang, 'concept')}>{d.ui.viewConcept}</a>
      </div>
    </div>
  </section>

  <OwnerBlock lang={lang} />

  <section class="section oisoba">
    <div class="wrap oisoba-grid">
      <div>
        <h2 class="section-title">{h.oisobaTitle}</h2>
        <p>{h.oisobaBody}</p>
        <p class="muted">{h.oisobaNote}</p>
      </div>
      <img class="oisoba-photo is-cutout" src={withBase('images/cut-oisoba.webp')} alt={h.oisobaTitle} width="350" height="429" loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="section how">
    <div class="wrap narrow">
      <h2 class="section-title">{h.howTitle}</h2>
      <ol class="steps">
        {h.howSteps.map((s) => <li>{s}</li>)}
      </ol>
      <p class="muted">{h.howNote}</p>
    </div>
  </section>

  <section class="section store">
    <div class="wrap store-grid">
      <div>
        <h2 class="section-title">{h.storeTitle}</h2>
        <InfoList lang={lang} />
        <p class="actions">
          <a class="btn btn-primary" href={mapsUrl} target="_blank" rel="noopener">{d.ui.viewAccess}</a>
          <a class="btn btn-line" href={pagePath(lang, 'access')}>{d.nav.access}</a>
        </p>
      </div>
      <div><MapBlock lang={lang} /></div>
    </div>
  </section>
</Base>
